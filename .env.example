# Локальная конфигурация. Файл в .gitignore и в репозиторий не попадает.
# Копировать не обязательно: без .env сервис запускается в офлайн-режиме
# и показывает результат по детерминированному шаблону, без ключа и без сети.

# Активный провайдер: openai | anthropic | google | openai_compatible | mock
LLM_PROVIDER=mock

# Ключ API выбранного провайдера
LLM_API_KEY=

# Модель. Пусто — возьмётся значение по умолчанию для провайдера
LLM_MODEL=

# Ниже — готовые блоки для подключения реальной модели.
# Раскомментируйте нужный и заполните ключ.

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# --- Anthropic Claude ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# LLM_API_KEY=sk-ant-...

# --- Google Gemini ---
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=...

# --- Любой OpenAI-совместимый endpoint (локальная модель, шлюз, прокси) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=название-модели
# LLM_API_KEY=...

# --- Необязательные настройки ---
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.2

# Как клиент представляется провайдеру
LLM_USER_AGENT=product-card/1.0

# Дополнительные заголовки в виде JSON — для корпоративных шлюзов и прокси.
# Пример: {"x-opencode-session":"product-card-local"}
LLM_EXTRA_HEADERS=
