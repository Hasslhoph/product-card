# Скопируйте файл в .env и подставьте свой ключ.
# .env добавлен в .gitignore и в репозиторий не попадает.
# Ни один из ключей не обязателен: ключ можно ввести прямо в веб-интерфейсе.

# Провайдер: openai | anthropic | google | openai_compatible | mock
LLM_PROVIDER=openai_compatible

# Ключ API выбранного провайдера
LLM_API_KEY=

# Модель. Примеры:
#   openai              -> gpt-4o-mini
#   anthropic           -> claude-3-5-haiku-latest
#   google              -> gemini-2.0-flash
#   openai_compatible   -> любая модель вашего endpoint
LLM_MODEL=deepseek-v4.1-flash

# Нужен только для провайдера openai_compatible.
# Пример: https://opencode.ai/inference/go/openai/v1
LLM_BASE_URL=

# Необязательные настройки
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.2

# Как клиент представляется провайдеру
LLM_USER_AGENT=product-card/1.0

# Дополнительные заголовки в виде JSON — для корпоративных шлюзов и прокси.
# Пример: {"x-opencode-session":"product-card-local"}
LLM_EXTRA_HEADERS=
